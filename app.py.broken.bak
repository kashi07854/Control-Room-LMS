# --- AI Study Buddy (Ollama) ---
@app.route("/api/ai/chat", methods=["POST"])
def api_ai_chat():
    data = request.get_json(silent=True) or {}
    prompt = data.get("prompt", "")
    item_id = data.get("item_id")
    
    context = ""
    if item_id:
        c = db_conn()
        try:
            item = c.execute("SELECT abs_path, ext FROM items WHERE id=?", (item_id,)).fetchone()
            if item and item["ext"] in ("txt", "md", "py", "js", "csv", "json"):
                try:
                    with open(item["abs_path"], "r", encoding="utf-8") as f:
                        context = f.read(8000) # Read first 8k chars
                except: pass
        finally:
            c.close()
            
    full_prompt = f"Context:\n{context}\n\nUser Question: {prompt}\n\nAnswer:" if context else prompt
    
    try:
        req = urllib.request.Request(
            "http://127.0.0.1:11434/api/generate",
            data=json.dumps({"model": "llama3", "prompt": full_prompt, "stream": False}).encode('utf-8'),
            headers={'Content-Type': 'application/json'}
        )
        with urllib.request.urlopen(req, timeout=60) as response:
            res = json.loads(response.read().decode())
            return jsonify({"ok": True, "response": res.get("response", "")})
    except Exception as e:
        return jsonify({"ok": False, "error": "Ollama connect nahi hua. Kya aapne 'ollama run llama3' run kiya hai?"})
@app.errorhandler(404)
def err404(e):
    return "<h2 style='font-family:sans-serif;padding:24px'>404 - Page not found - <a href='/'>Go to Dashboard</a></h2>", 404

@app.errorhandler(500)
def err500(e):
    app_log.exception("500 error")
    return "<h2 style='font-family:sans-serif;padding:24px'>500 - Internal error - <a href='/'>Go to Dashboard</a></h2>", 500

def create_startup_backup():
    import shutil
    bdir = BASE / "backups"
    bdir.mkdir(exist_ok=True)
    if DB_PATH.exists():
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        dst = bdir / f"index_{ts}.db"
        try:
            c = db_conn()
            bck = sqlite3.connect(dst)
            c.backup(bck)
            bck.close()
            c.close()
            app_log.info(f"Backup created: {dst.name}")
            # Keep only last 5 backups
            backups = sorted(bdir.glob("index_*.db"))
            if len(backups) > 5:
                for old in backups[:-5]:
                    old.unlink()
        except Exception as e:
            app_log.error(f"Backup failed: {e}")

if __name__ == "__main__":
    init_db()
    create_startup_backup()
    app_log.info("Control Room starting")
    print("\n" + "=" * 60)
    print(f"  Control Room -> http://{CONFIG['host']}:{CONFIG['port']}")
    print("=" * 60 + "\n")
    app.run(host=CONFIG["host"], port=CONFIG["port"], debug=False, use_reloader=False)