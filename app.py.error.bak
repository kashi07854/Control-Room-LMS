@app.route("/api/tags/<int:item_id>", methods=["POST"])
def api_add_tag(item_id):
    data = request.get_json(silent=True) or {}
    tag_name = (data.get("tag_name") or "").strip().lower()
    if not tag_name or len(tag_name) > 20:
        return jsonify({"ok": False, "error": "Invalid tag"}), 400
    c = db_conn()
    try:
        c.execute("INSERT OR IGNORE INTO tags(name) VALUES (?)", (tag_name,))
        tag_id = c.execute("SELECT id FROM tags WHERE name=?", (tag_name,)).fetchone()["id"]
        c.execute("INSERT OR IGNORE INTO item_tags(item_id, tag_id) VALUES (?,?)", (item_id, tag_id))
        c.commit()
        return jsonify({"ok": True})
    finally: c.close()

