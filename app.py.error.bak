@app.route("/api/favorite", methods=["POST"])
def api_favorite():
    data = request.get_json(silent=True) or {}
    item_id = data.get("item_id")
    c = db_conn()
    try:
        if not c.execute("SELECT 1 FROM items WHERE id=?", (item_id,)).fetchone():
            return jsonify({"ok": False, "error": "Item not found"}), 404
        if c.execute("SELECT 1 FROM favorites WHERE item_id=?", (item_id,)).fetchone():
            c.execute("DELETE FROM favorites WHERE item_id=?", (item_id,))
            c.commit()
            return jsonify({"ok": True, "favorite": False})
        c.execute("INSERT INTO favorites(item_id, created_at) VALUES (?,?)",
                  (item_id, datetime.utcnow().isoformat()))
        c.commit()
        return jsonify({"ok": True, "favorite": True})
    finally: c.close()

