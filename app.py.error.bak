@app.route("/api/ai/chat", methods=["POST"])
def api_ai_chat():
    data = request.get_json(silent=True) or {}
    prompt = data.get("prompt", ""); item_id = data.get("item_id")
    context = ""
    if item_id:
        c = db_conn()
        try:
            item = c.execute("SELECT abs_path, ext FROM items WHERE id=?", (item_id,)).fetchone()
            if item and item["ext"] in ("txt", "md", "py", "js", "csv", "json"):
                try:
                    with open(item["abs_path"], "r", encoding="utf-8") as f:
                        context = f.read(8000)
                except: pass
        finally: c.close()
    full_prompt = f"Context:\n{context}\n\nUser Question: {prompt}\n\nAnswer:" if context else prompt
    try:
        req = urllib.request.Request(
            "http://127.0.0.1:11434/api/generate",
            data=json.dumps({"model": "llama3", "prompt": full_prompt, "stream": False}).encode('utf-8'),
            headers={'Content-Type': 'application/json'})
        with urllib.request.urlopen(req, timeout=60) as response:
            res = json.loads(response.read().decode())
            return jsonify({"ok": True, "response": res.get("response", "")})
    except Exception:
        return jsonify({"ok": False, "error": "Ollama connect nahi hua. Kya 'ollama run llama3' chal raha hai?"})

@app.route("/api/quick_capture", methods=["POST"])
def api_quick_capture():
    data = request.get_json(silent=True) or {}
    text = data.get("text", "").strip()
    if not text: return jsonify({"ok": False, "error": "Empty"}), 400
    inbox_file = BASE / "data" / "Quick_Inbox.md"
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M")
    try:
        with open(inbox_file, "a", encoding="utf-8") as f:
            f.write(f"\n- [{timestamp}] {text}")
        return jsonify({"ok": True})
    except Exception as e:
        return jsonify({"ok": False, "error": str(e)}), 500

@app.route("/api/raw_text/<int:item_id>")
def api_raw_text(item_id):
    c = db_conn()
    try:
        item = c.execute("SELECT abs_path, ext FROM items WHERE id=?", (item_id,)).fetchone()
    finally: c.close()
    if not item or item["ext"] not in ("txt", "md", "csv", "py", "html"):
        return "Text not available", 400
    try:
        with open(item["abs_path"], "r", encoding="utf-8") as f:
            return f.read(10000)
    except Exception:
        return "Error reading file", 500

@app.route("/export/progress")
def export_progress():
    c = db_conn()
    try:
        rows = c.execute("""SELECT i.name, i.rel_path,
                            COALESCE(p.status,'not_started') as status,
                            COALESCE(p.percent,0) as percent, n.note_text
                            FROM items i LEFT JOIN progress p ON p.item_id=i.id
                            LEFT JOIN notes n ON n.item_id=i.id
                            WHERE i.item_type='file' AND i.is_deleted=0
                            ORDER BY i.rel_path""").fetchall()
    finally: c.close()
    si = io.StringIO(); cw = csv.writer(si)
    cw.writerow(['File Name', 'Path', 'Status', 'Percent', 'Notes'])
    for r in rows:
        cw.writerow([r['name'], r['rel_path'], r['status'], r['percent'], r['note_text'] or ''])
    return Response(si.getvalue(), mimetype="text/csv",
                    headers={"Content-disposition": "attachment; filename=control_room_progress.csv"})

@app.errorhandler(404)
def err404(e):
    return "<h2 style='font-family:sans-serif;padding:24px'>404 - Not found - <a href='/'>Home</a></h2>", 404

@app.errorhandler(500)
def err500(e):
    app_log.exception("500 error")
    return "<h2 style='font-family:sans-serif;padding:24px'>500 - Internal error - <a href='/'>Home</a></h2>", 500

if __name__ == "__main__":
    if not ROOT.exists():
        print(f"\nERROR: Root path does not exist: {ROOT}")
        print("Start Google Drive for Desktop and try again.\n")
        sys.exit(1)
    init_db()
    create_startup_backup()
    app_log.info("Control Room starting")
    print("\n" + "=" * 60)
    print(f"  Control Room -> http://{CONFIG['host']}:{CONFIG['port']}")
    print(f"  Root         -> {ROOT}")
    print(f"  DB           -> {DB_PATH}")
    print("=" * 60 + "\n")
    app.run(host=CONFIG["host"], port=CONFIG["port"], debug=False, use_reloader=False, threaded=True)


