"""Control Room + LMS - Clean Rebuild (v3)."""
import os, sys, json, sqlite3, threading, subprocess, logging, ctypes, time, hashlib, csv, io
import urllib.request, urllib.error
from pathlib import Path
from datetime import datetime, timedelta, date
from logging.handlers import RotatingFileHandler
from flask import Flask, render_template, request, jsonify, abort, send_file, Response
import html as html_lib

BASE = Path(__file__).resolve().parent

def load_config():
    with open(BASE / "config.json", "r", encoding="utf-8") as f:
        return json.load(f)

CONFIG       = load_config()
ROOT         = Path(CONFIG["root_path"]).resolve()
DB_PATH      = Path(CONFIG["db_path"]).resolve()
EXCLUDES     = set(CONFIG.get("exclude_names", []))
COURSE_ROOTS = CONFIG.get("course_roots", [])
PAGE_SIZE    = int(CONFIG.get("page_size", 500))

for sub in ("data", "data/exports", "logs", "backups"):
    (BASE / sub).mkdir(parents=True, exist_ok=True)

def _log(name, fname):
    lg = logging.getLogger(name); lg.setLevel(logging.INFO)
    h = RotatingFileHandler(BASE / "logs" / fname, maxBytes=2_000_000, backupCount=3, encoding="utf-8")
    h.setFormatter(logging.Formatter("%(asctime)s | %(levelname)s | %(message)s"))
    lg.addHandler(h)
    s = logging.StreamHandler(sys.stdout)
    s.setFormatter(logging.Formatter("%(asctime)s | %(levelname)s | %(message)s"))
    lg.addHandler(s)
    return lg

app_log  = _log("app",  "app.log")
scan_log = _log("scan", "scan.log")

def db_conn():
    c = sqlite3.connect(DB_PATH, timeout=30)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA foreign_keys=ON")
    c.execute("PRAGMA busy_timeout=30000")
    return c

SCHEMA = """
CREATE TABLE IF NOT EXISTS items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    parent_id INTEGER,
    name TEXT NOT NULL,
    rel_path TEXT NOT NULL UNIQUE,
    abs_path TEXT NOT NULL,
    item_type TEXT NOT NULL CHECK(item_type IN ('file','folder')),
    ext TEXT, size INTEGER, mtime REAL, depth INTEGER,
    is_course_root INTEGER DEFAULT 0, is_course INTEGER DEFAULT 0, is_unit INTEGER DEFAULT 0,
    is_deleted INTEGER DEFAULT 0, is_cloud_placeholder INTEGER DEFAULT 0,
    created_at TEXT, updated_at TEXT
);
CREATE INDEX IF NOT EXISTS idx_items_parent  ON items(parent_id);
CREATE INDEX IF NOT EXISTS idx_items_rel     ON items(rel_path);
CREATE INDEX IF NOT EXISTS idx_items_type    ON items(item_type);
CREATE INDEX IF NOT EXISTS idx_items_deleted ON items(is_deleted);
CREATE INDEX IF NOT EXISTS idx_items_course  ON items(is_course);
CREATE TABLE IF NOT EXISTS progress (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    item_id INTEGER UNIQUE NOT NULL REFERENCES items(id) ON DELETE CASCADE,
    status TEXT NOT NULL CHECK(status IN ('not_started','in_progress','completed')) DEFAULT 'not_started',
    percent INTEGER NOT NULL DEFAULT 0 CHECK(percent BETWEEN 0 AND 100),
    updated_at TEXT
);
CREATE TABLE IF NOT EXISTS notes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    item_id INTEGER NOT NULL UNIQUE REFERENCES items(id) ON DELETE CASCADE,
    note_text TEXT NOT NULL DEFAULT '', updated_at TEXT
);
CREATE TABLE IF NOT EXISTS favorites (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    item_id INTEGER NOT NULL UNIQUE REFERENCES items(id) ON DELETE CASCADE,
    created_at TEXT
);
CREATE TABLE IF NOT EXISTS scan_log (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    started_at TEXT, finished_at TEXT, status TEXT,
    total_folders INTEGER DEFAULT 0, total_files INTEGER DEFAULT 0, errors INTEGER DEFAULT 0
);
CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT);
CREATE TABLE IF NOT EXISTS tags (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL UNIQUE);
CREATE TABLE IF NOT EXISTS item_tags (
    item_id INTEGER NOT NULL REFERENCES items(id) ON DELETE CASCADE,
    tag_id INTEGER NOT NULL REFERENCES tags(id) ON DELETE CASCADE,
    PRIMARY KEY (item_id, tag_id)
);
CREATE TABLE IF NOT EXISTS flashcards (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    item_id INTEGER REFERENCES items(id) ON DELETE CASCADE,
    question TEXT NOT NULL, answer TEXT NOT NULL,
    status TEXT DEFAULT 'new', created_at TEXT
);
CREATE TABLE IF NOT EXISTS time_sessions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    item_id INTEGER NOT NULL REFERENCES items(id) ON DELETE CASCADE,
    duration_seconds INTEGER NOT NULL DEFAULT 0, recorded_at TEXT
);
"""

def init_db():
    c = db_conn()
    c.executescript(SCHEMA)
    c.execute("UPDATE scan_log SET status='interrupted' WHERE status='running'")
    c.commit(); c.close()

def create_startup_backup():
    import shutil
    bdir = BASE / "backups"; bdir.mkdir(exist_ok=True)
    if DB_PATH.exists():
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        dst = bdir / f"index_{ts}.db"
        try:
            c = db_conn(); bck = sqlite3.connect(dst)
            c.backup(bck); bck.close(); c.close()
            app_log.info(f"Backup created: {dst.name}")
            backups = sorted(bdir.glob("index_*.db"))
            if len(backups) > 5:
                for old in backups[:-5]: old.unlink()
        except Exception as e:
            app_log.error(f"Backup failed: {e}")

SCAN_STATE = {"running": False, "finished": None, "done": 0, "current": "",
              "errors": 0, "total_files": 0, "total_folders": 0}
SCAN_LOCK = threading.Lock()

def is_cloud_placeholder(p):
    try:
        OFFLINE = 0x1000; RECALL = 0x400000
        attrs = ctypes.windll.kernel32.GetFileAttributesW(str(p))
        if attrs == -1 or attrs == 0xFFFFFFFF: return False
        return bool(attrs & (OFFLINE | RECALL))
    except Exception:
        return False

def safe_walk(root):
    stack = [(root, 0)]
    while stack:
        current, depth = stack.pop()
        try: entries = list(os.scandir(current))
        except (PermissionError, OSError) as e:
            scan_log.warning(f"skip {current}: {e}"); SCAN_STATE["errors"] += 1; continue
        for entry in entries:
            try:
                if entry.name in EXCLUDES: continue
                if entry.is_symlink(): continue
                p = Path(entry.path)
                if entry.is_dir(follow_symlinks=False):
                    yield (p, depth + 1, True); stack.append((p, depth + 1))
                elif entry.is_file(follow_symlinks=False):
                    yield (p, depth + 1, False)
            except OSError as e:
                scan_log.warning(f"stat fail {entry.path}: {e}"); SCAN_STATE["errors"] += 1

def classify(rel, is_dir):
    parts = rel.split("/")
    if not parts or parts[0] not in COURSE_ROOTS: return (0, 0, 0)
    if len(parts) == 1 and is_dir: return (1, 0, 0)
    if len(parts) == 2 and is_dir: return (0, 1, 0)
    if len(parts) >= 3 and is_dir: return (0, 0, 1)
    return (0, 0, 0)

def get_parent_id(c, rel):
    if "/" not in rel: return None
    parent = rel.rsplit("/", 1)[0]
    row = c.execute("SELECT id FROM items WHERE rel_path=?", (parent,)).fetchone()
    return row["id"] if row else None

def scan_worker():
    with SCAN_LOCK:
        if SCAN_STATE["running"]: return
        SCAN_STATE.update({"running": True, "finished": None, "done": 0,
                           "current": "", "errors": 0, "total_files": 0, "total_folders": 0})
    c = db_conn(); scan_id = None
    try:
        cur = c.execute("INSERT INTO scan_log(started_at, status) VALUES (?, 'running')",
                        (datetime.utcnow().isoformat(),))
        scan_id = cur.lastrowid; c.commit()
        seen = set(); now = datetime.utcnow().isoformat()
        for abs_path, depth, is_dir in safe_walk(ROOT):
            try: rel = str(abs_path.relative_to(ROOT)).replace("\\", "/")
            except ValueError: continue
            if not rel or rel.startswith(".."): continue
            seen.add(rel); SCAN_STATE["current"] = rel
            try:
                st = abs_path.stat()
                size, mtime = (0, 0) if is_dir else (st.st_size, st.st_mtime)
            except OSError: size, mtime = 0, 0
            ext = "" if is_dir else abs_path.suffix.lower().lstrip(".")
            placeholder = 0 if is_dir else (1 if is_cloud_placeholder(abs_path) else 0)
            cr, co, un = classify(rel, is_dir)
            parent_id = get_parent_id(c, rel)
            existing = c.execute("SELECT id FROM items WHERE rel_path=?", (rel,)).fetchone()
            if existing:
                c.execute("""UPDATE items SET parent_id=?, name=?, abs_path=?, item_type=?,
                             ext=?, size=?, mtime=?, depth=?, is_course_root=?, is_course=?,
                             is_unit=?, is_deleted=0, is_cloud_placeholder=?, updated_at=?
                             WHERE id=?""",
                          (parent_id, abs_path.name, str(abs_path),
                           "folder" if is_dir else "file", ext, size, mtime, depth,
                           cr, co, un, placeholder, now, existing["id"]))
            else:
                c.execute("""INSERT INTO items(parent_id, name, rel_path, abs_path, item_type,
                             ext, size, mtime, depth, is_course_root, is_course, is_unit,
                             is_cloud_placeholder, created_at, updated_at)
                             VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                          (parent_id, abs_path.name, rel, str(abs_path),
                           "folder" if is_dir else "file", ext, size, mtime, depth,
                           cr, co, un, placeholder, now, now))
            SCAN_STATE["done"] += 1
            if is_dir: SCAN_STATE["total_folders"] += 1
            else: SCAN_STATE["total_files"] += 1
            if SCAN_STATE["done"] % 200 == 0: c.commit()
        if seen:
            c.execute("CREATE TEMP TABLE IF NOT EXISTS seen_rel (rel TEXT PRIMARY KEY)")
            c.execute("DELETE FROM seen_rel")
            c.executemany("INSERT OR IGNORE INTO seen_rel(rel) VALUES (?)", [(r,) for r in seen])
            c.execute("UPDATE items SET is_deleted=1 WHERE is_deleted=0 AND rel_path NOT IN (SELECT rel FROM seen_rel)")
            c.execute("DROP TABLE seen_rel")
        c.execute("""UPDATE scan_log SET finished_at=?, status='ok', total_folders=?,
                     total_files=?, errors=? WHERE id=?""",
                  (datetime.utcnow().isoformat(), SCAN_STATE["total_folders"],
                   SCAN_STATE["total_files"], SCAN_STATE["errors"], scan_id))
        c.commit()
        scan_log.info(f"scan complete: {SCAN_STATE['total_files']} files, "
                      f"{SCAN_STATE['total_folders']} folders, {SCAN_STATE['errors']} errors")
    except Exception as e:
        scan_log.exception(f"scan failed: {e}")
        try:
            c.execute("UPDATE scan_log SET finished_at=?, status='error', errors=errors+1 WHERE id=?",
                      (datetime.utcnow().isoformat(), scan_id)); c.commit()
        except Exception: pass
    finally:
        c.close(); SCAN_STATE["running"] = False; SCAN_STATE["finished"] = time.time()

def safe_resolve(rel):
    if not rel: return ROOT
    rel = rel.replace("\\", "/").strip("/")
    if any(p == ".." for p in rel.split("/")): abort(400)
    target = (ROOT / rel.replace("/", os.sep)).resolve()
    try: target.relative_to(ROOT)
    except ValueError: abort(400)
    return target

def to_rel(target):
    r = str(target.relative_to(ROOT)).replace("\\", "/")
    return "" if r == "." else r

def get_heatmap_data(days=364):
    today = date.today()
    start = today - timedelta(days=days)
    while start.weekday() != 6: start -= timedelta(days=1)
    c = db_conn()
    try:
        rows = c.execute("""SELECT substr(recorded_at,1,10) as d, SUM(duration_seconds) as secs
                            FROM time_sessions WHERE recorded_at >= ?
                            GROUP BY substr(recorded_at,1,10)""", (start.isoformat(),)).fetchall()
        time_map = {r["d"]: r["secs"] for r in rows}
        prog = c.execute("""SELECT substr(updated_at,1,10) as d, COUNT(*) as cnt
                            FROM progress WHERE status='completed' AND updated_at >= ?
                            GROUP BY substr(updated_at,1,10)""", (start.isoformat(),)).fetchall()
        for p in prog:
            time_map[p["d"]] = time_map.get(p["d"], 0) + (p["cnt"] * 120)
    finally: c.close()
    cells = []; cur = start
    total_weeks = ((today - start).days // 7) + 1
    for w in range(total_weeks):
        week = []
        for d in range(7):
            day_iso = cur.isoformat()
            secs = time_map.get(day_iso, 0) if cur <= today else -1
            if secs < 0: level = -1
            elif secs == 0: level = 0
            elif secs < 300: level = 1
            elif secs < 900: level = 2
            elif secs < 1800: level = 3
            else: level = 4
            week.append({"date": day_iso, "secs": max(0, secs), "level": level})
            cur += timedelta(days=1)
        cells.append(week)
    return cells, total_weeks

app = Flask(__name__)
app.secret_key = os.urandom(24).hex()

@app.route("/")
def dashboard():
    c = db_conn()
    try:
        total_files   = c.execute("SELECT COUNT(*) c FROM items WHERE item_type='file'   AND is_deleted=0").fetchone()["c"]
        total_folders = c.execute("SELECT COUNT(*) c FROM items WHERE item_type='folder' AND is_deleted=0").fetchone()["c"]
        courses       = c.execute("SELECT id,name,rel_path FROM items WHERE is_course=1 AND is_deleted=0 ORDER BY name LIMIT 50").fetchall()
        prog = c.execute("""SELECT p.status, COUNT(*) c FROM progress p JOIN items i ON p.item_id=i.id
                            WHERE i.item_type='file' AND i.is_deleted=0 GROUP BY p.status""").fetchall()
        status_counts = {"not_started": 0, "in_progress": 0, "completed": 0}
        for r in prog: status_counts[r["status"]] = r["c"]
        total_prog = sum(status_counts.values())
        overall = (status_counts["completed"] / total_prog * 100) if total_prog else 0.0
        recent = c.execute("""SELECT id,name,rel_path,item_type,mtime FROM items
                              WHERE is_deleted=0 AND item_type='file'
                              ORDER BY mtime DESC LIMIT 10""").fetchall()
        continue_items = c.execute("""SELECT i.id, i.name, i.rel_path, p.updated_at
            FROM items i JOIN progress p ON p.item_id=i.id
            WHERE p.status='in_progress' AND i.is_deleted=0
            ORDER BY p.updated_at DESC LIMIT 5""").fetchall()
        total_seconds = c.execute("SELECT COALESCE(SUM(duration_seconds),0) s FROM time_sessions").fetchone()["s"]
        total_hours = round(total_seconds / 3600, 1)
        last_scan = c.execute("SELECT * FROM scan_log ORDER BY id DESC LIMIT 1").fetchone()
    finally: c.close()
    heatmap, weeks = get_heatmap_data()
    return render_template("dashboard.html",
        total_files=total_files, total_folders=total_folders, courses=courses,
        status_counts=status_counts, overall=overall, recent=recent, last_scan=last_scan,
        heatmap=heatmap, total_hours=total_hours, continue_items=continue_items)

@app.route("/browse")
def browse():
    rel = request.args.get("path", "").replace("\\", "/").strip("/")
    c = db_conn()
    try:
        current = None
        if rel:
            current = c.execute("SELECT id, name FROM items WHERE rel_path=?", (rel,)).fetchone()
            if not current:
                # Fallback for old DB paths
                bs_rel = rel.replace("/", "\\")
                current = c.execute("SELECT id, name FROM items WHERE rel_path=?", (bs_rel,)).fetchone()
                if current: rel = bs_rel
        
        if rel and not current:
            return render_template("browse.html", error="Folder not found in DB. Please scan again.", items=[], breadcrumbs=[], rel=rel)

        if current:
            items = c.execute("""SELECT i.id, i.name, i.rel_path, i.item_type, i.ext, i.size, i.mtime,
                                 i.is_course, i.is_unit, COALESCE(p.status, 'not_started') as status
                                 FROM items i LEFT JOIN progress p ON p.item_id = i.id
                                 WHERE i.parent_id=? AND i.is_deleted=0
                                 ORDER BY i.item_type DESC, i.name COLLATE NOCASE LIMIT ?""",
                              (current["id"], PAGE_SIZE)).fetchall()
        else:
            items = c.execute("""SELECT i.id, i.name, i.rel_path, i.item_type, i.ext, i.size, i.mtime,
                                 i.is_course, i.is_unit, COALESCE(p.status, 'not_started') as status
                                 FROM items i LEFT JOIN progress p ON p.item_id = i.id
                                 WHERE i.parent_id IS NULL AND i.is_deleted=0
                                 ORDER BY i.item_type DESC, i.name COLLATE NOCASE LIMIT ?""",
                              (PAGE_SIZE,)).fetchall()

        breadcrumbs = []
        if rel:
            parts = rel.split("/")
            for i, p in enumerate(parts):
                breadcrumbs.append({"name": p, "path": "/".join(parts[:i + 1])})

        return render_template("browse.html", items=items, rel=rel, breadcrumbs=breadcrumbs, error=None)
    except Exception as e:
        app_log.error(f"Browse error: {e}")
        return render_template("browse.html", error="An error occurred while loading this folder.", items=[], breadcrumbs=[], rel=rel), 500
    finally:
        c.close()
@app.route("/search")
def search():
    q = request.args.get("q", "").strip()
    status = request.args.get("status", "")
    typ = request.args.get("type", "")
    c = db_conn()
    try:
        sql = """SELECT i.id, i.name, i.rel_path, i.item_type, i.ext, i.size, i.mtime,
                        COALESCE(p.status,'not_started') status
                 FROM items i LEFT JOIN progress p ON p.item_id=i.id
                 WHERE i.is_deleted=0"""
        params = []
        if q:
            sql += " AND (i.name LIKE ? OR i.rel_path LIKE ?)"
            params += [f"%{q}%", f"%{q}%"]
        if typ in ("file", "folder"):
            sql += " AND i.item_type = ?"; params.append(typ)
        if status:
            sql += " AND COALESCE(p.status,'not_started') = ?"; params.append(status)
        sql += " ORDER BY i.item_type DESC, i.name COLLATE NOCASE LIMIT 500"
        results = c.execute(sql, params).fetchall()
        return render_template("search.html", results=results, q=q,
                               status_filter=status, type_filter=typ)
    finally: c.close()

@app.route("/progress")
def progress_page():
    c = db_conn()
    try:
        rows = c.execute("""SELECT i.id, i.name, i.rel_path, i.item_type,
                            COALESCE(p.status,'not_started') status, COALESCE(p.percent,0) percent
                            FROM items i LEFT JOIN progress p ON p.item_id=i.id
                            WHERE i.is_deleted=0 AND i.item_type='file'
                            ORDER BY i.rel_path COLLATE NOCASE LIMIT 500""").fetchall()
        return render_template("progress.html", rows=rows)
    finally: c.close()

@app.route("/course/<int:item_id>")
def course(item_id):
    c = db_conn()
    try:
        item = c.execute("SELECT * FROM items WHERE id=?", (item_id,)).fetchone()
        if not item: abort(404)
        children = c.execute("""SELECT i.*, COALESCE(p.status,'not_started') status,
                                COALESCE(p.percent,0) percent FROM items i
                                LEFT JOIN progress p ON p.item_id=i.id
                                WHERE i.parent_id=? AND i.is_deleted=0
                                ORDER BY i.item_type DESC, i.name COLLATE NOCASE LIMIT ?""",
                             (item_id, PAGE_SIZE)).fetchall()
        files = c.execute("""SELECT COALESCE(p.status,'not_started') status FROM items i
                             LEFT JOIN progress p ON p.item_id=i.id
                             WHERE i.rel_path LIKE ? AND i.item_type='file' AND i.is_deleted=0""",
                          (item["rel_path"] + "/%",)).fetchall()
        statuses = {"not_started": 0, "in_progress": 0, "completed": 0}
        for f in files: statuses[f["status"]] += 1
        total = sum(statuses.values())
        overall = (statuses["completed"] / total * 100) if total else 0.0
        return render_template("course.html", course=item, children=children,
                               statuses=statuses, overall=overall, total=total)
    finally: c.close()

@app.route("/unit/<int:item_id>")
def unit(item_id):
    c = db_conn()
    try:
        item = c.execute("SELECT * FROM items WHERE id=?", (item_id,)).fetchone()
        if not item: abort(404)
        prog = c.execute("SELECT * FROM progress  WHERE item_id=?", (item_id,)).fetchone()
        note = c.execute("SELECT * FROM notes     WHERE item_id=?", (item_id,)).fetchone()
        fav  = c.execute("SELECT * FROM favorites WHERE item_id=?", (item_id,)).fetchone()
        return render_template("unit.html", item=item,
            status=prog["status"] if prog else "not_started",
            percent=prog["percent"] if prog else 0,
            note=note["note_text"] if note else "",
            favorite=bool(fav))
    finally: c.close()

@app.route("/weekly")
def weekly():
    excel_path = BASE / "data" / "Life_OS_Master_COMPLETE.xlsx"
    data = {"error": None, "rows": [], "headers": []}
    
    if not excel_path.exists():
        data["error"] = "Excel file not found in data/ folder. Please copy Life_OS_Master_COMPLETE.xlsx to 00_CONTROL_ROOM\data\"
        return render_template("weekly.html", data=data)

    try:
        # Use openpyxl to read formulas and hyperlinks
        wb = openpyxl.load_workbook(excel_path, data_only=True)
        sheet_name = 'Learning Department' if 'Learning Department' in wb.sheetnames else wb.sheetnames[0]
        ws = wb[sheet_name]
        
        # Extract headers (row 8)
        headers = []
        for cell in ws[8]:
            headers.append(cell.value if cell.value else "")
        
        # We only need specific columns: A(1), B(2), C(3), D(4), E(5), F(6), G(7), H(8), I(9), J(10), K(11)
        # Let's extract rows 9 to 23
        rows = []
        for row_idx in range(9, 24):
            row_data = []
            for col_idx in range(1, 12):
                cell = ws.cell(row=row_idx, column=col_idx)
                val = cell.value
                hyperlink = cell.hyperlink.target if cell.hyperlink else None
                
                # If cell has a hyperlink or a path, convert to web link
                if hyperlink or (isinstance(val, str) and "G:\\My Drive\\" in val):
                    target_path = hyperlink if hyperlink else val
                    # Clean path
                    rel_path = target_path.replace("G:\\My Drive\\", "").replace("\\", "/")
                    
                    # Create HTML link
                    val = f'<a href="/browse?path={urllib.parse.quote(rel_path)}" class="btn btn-sm btn-primary py-0" style="font-size:11px;">Open Folder</a>'
                elif isinstance(val, str) and val.startswith("="):
                    val = "" # Clear formulas like =HYPERLINK
                
                row_data.append(val)
            rows.append(row_data)
            
        data["headers"] = headers
        data["rows"] = rows
        data["sheet"] = sheet_name
        
    except Exception as e:
        data["error"] = f"Error reading Excel: {str(e)}"
        
    return render_template("weekly.html", data=data)

@app.route("/preview/<int:item_id>")
def direct_preview(item_id):
    """Forces the browser to display the file in a new tab (PDF, Images, Videos)."""
    c = db_conn()
    try:
        item = c.execute("SELECT * FROM items WHERE id=?", (item_id,)).fetchone()
    finally:
        c.close()
    
    if not item or item["is_deleted"] or item["item_type"] != "file":
        abort(404)
    
    p = Path(item["abs_path"])
    if not p.exists():
        abort(404)
        
    # Let the browser handle it via send_file
    return send_file(p, as_attachment=False)
@app.route("/preview/<int:item_id>")
def direct_preview(item_id):
    """Forces the browser to display the file in a new tab (PDF, Images, Videos)."""
    c = db_conn()
    try:
        item = c.execute("SELECT * FROM items WHERE id=?", (item_id,)).fetchone()
    finally:
        c.close()
    
    if not item or item["is_deleted"] or item["item_type"] != "file":
        abort(404)
    
    p = Path(item["abs_path"])
    if not p.exists():
        abort(404)
        
    # Let the browser handle it via send_file
    return send_file(p, as_attachment=False)
@app.route("/settings")
def settings_page():
    return render_template("settings.html", config=CONFIG)

@app.route("/flashcards")
def flashcards_page():
    c = db_conn()
    try:
        cards = c.execute("SELECT * FROM flashcards ORDER BY created_at DESC").fetchall()
        return render_template("flashcards.html", cards=cards)
    finally: c.close()

@app.route("/tools/duplicates")
def tools_duplicates():
    c = db_conn()
    try:
        sizes = c.execute("""SELECT size, COUNT(*) c FROM items
                             WHERE item_type='file' AND size > 0 AND is_deleted=0
                             GROUP BY size HAVING c > 1""").fetchall()
        groups = []
        for s in sizes:
            files = c.execute("""SELECT id, name, rel_path, abs_path, size FROM items
                                 WHERE size=? AND item_type='file' AND is_deleted=0""",
                              (s["size"],)).fetchall()
            hashes = {}
            for f in files:
                try:
                    with open(f["abs_path"], 'rb') as fh:
                        h = hashlib.md5(fh.read(65536)).hexdigest()
                    if h not in hashes: hashes[h] = []
                    hashes[h].append(f)
                except Exception: pass
            for h, matches in hashes.items():
                if len(matches) > 1:
                    groups.append({"size": s["size"], "files": matches})
        return render_template("duplicates.html", groups=groups)
    finally: c.close()

@app.route("/api/scan", methods=["POST"])
def api_scan():
    if SCAN_STATE["running"]:
        return jsonify({"ok": False, "error": "Scan already running"}), 409
    threading.Thread(target=scan_worker, daemon=True).start()
    return jsonify({"ok": True})

@app.route("/api/scan_status")
def api_scan_status():
    return jsonify(SCAN_STATE)

@app.route("/api/progress", methods=["POST"])
def api_progress():
    data = request.get_json(silent=True) or {}
    item_id = data.get("item_id"); status = data.get("status")
    percent = data.get("percent", 0)
    if status not in ("not_started", "in_progress", "completed"):
        return jsonify({"ok": False, "error": "Invalid status"}), 400
    try: percent = int(percent)
    except (TypeError, ValueError): return jsonify({"ok": False, "error": "Invalid percent"}), 400
    if status == "completed": percent = 100
    if status == "not_started": percent = 0
    if not (0 <= percent <= 100): return jsonify({"ok": False}), 400
    c = db_conn()
    try:
        if not c.execute("SELECT 1 FROM items WHERE id=?", (item_id,)).fetchone():
            return jsonify({"ok": False, "error": "Item not found"}), 404
        c.execute("""INSERT INTO progress(item_id, status, percent, updated_at) VALUES (?,?,?,?)
                     ON CONFLICT(item_id) DO UPDATE SET status=excluded.status,
                     percent=excluded.percent, updated_at=excluded.updated_at""",
                  (item_id, status, percent, datetime.utcnow().isoformat()))
        c.commit()
        return jsonify({"ok": True})
    finally: c.close()

@app.route("/api/note", methods=["POST"])
def api_note():
    data = request.get_json(silent=True) or {}
    item_id = data.get("item_id"); text = (data.get("note_text") or "")[:50000]
    c = db_conn()
    try:
        if not c.execute("SELECT 1 FROM items WHERE id=?", (item_id,)).fetchone():
            return jsonify({"ok": False, "error": "Item not found"}), 404
        now = datetime.utcnow().isoformat()
        if c.execute("SELECT 1 FROM notes WHERE item_id=?", (item_id,)).fetchone():
            c.execute("UPDATE notes SET note_text=?, updated_at=? WHERE item_id=?", (text, now, item_id))
        else:
            c.execute("INSERT INTO notes(item_id, note_text, updated_at) VALUES (?,?,?)", (item_id, text, now))
        c.commit()
        return jsonify({"ok": True})
    finally: c.close()

