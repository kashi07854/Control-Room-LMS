@app.route("/api/open_explorer", methods=["POST"])
def api_open_explorer():
    data = request.get_json(silent=True) or {}
    rel = data.get("path", "")
    target = safe_resolve(rel)
    if not target.exists():
        return jsonify({"ok": False, "error": "Path not found"}), 404
    try:
        if target.is_dir(): subprocess.Popen(["explorer", str(target)])
        else: subprocess.Popen(["explorer", "/select,", str(target)])
        return jsonify({"ok": True})
    except Exception as e:
        return jsonify({"ok": False, "error": str(e)}), 500

@app.route("/api/preview/<int:item_id>")
def api_preview(item_id):
    c = db_conn()
    try:
        item = c.execute("SELECT * FROM items WHERE id=?", (item_id,)).fetchone()
    finally: c.close()
    if not item or item["is_deleted"] or item["item_type"] != "file":
        return "Not found", 404
    if item["is_cloud_placeholder"]:
        return "<div class='alert alert-warning m-3'>Cloud-only file. Download in Drive first.</div>", 400
    p = Path(item["abs_path"])
    if not p.exists():
        return "<div class='alert alert-danger m-3'>File missing.</div>", 404
    ext = (item["ext"] or "").lower()
    if ext in ("jpg", "jpeg", "png", "gif", "webp", "bmp", "svg"):
        return send_file(p)
    elif ext == "pdf":
        return send_file(p, mimetype="application/pdf")
    elif ext in ("txt", "md", "py", "js", "html", "css", "json", "csv", "log", "c", "cpp", "java"):
        if p.stat().st_size > 1_000_000:
            return "<div class='alert alert-warning m-3'>File too large (>1MB).</div>"
        try: content = p.read_text(encoding="utf-8")
        except UnicodeDecodeError: content = p.read_text(encoding="latin-1")
        return f"<pre style='white-space:pre-wrap;word-wrap:break-word;padding:16px;font-family:monospace;font-size:13px;margin:0;background:#f8fafc;'>{html_lib.escape(content)}</pre>"
    return "<div class='alert alert-secondary m-3'>Preview not supported.</div>", 415

