{% extends "base.html" %}
{% block body %}
<h1>File Browser</h1>
<nav class="breadcrumb-nav">
  <a href="/browse">Root</a>
  {% for b in breadcrumbs %}
    <span> / </span><a href="/browse?path={{ b.path|urlencode }}">{{ b.name }}</a>
  {% endfor %}
</nav>

{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

{% if items %}
<table class="table table-hover">
  <thead><tr><th>Name</th><th>Type</th><th>Size</th><th>Modified</th><th></th></tr></thead>
  <tbody>
    {% for it in items %}
    <tr>
      <td>
        {% if it.item_type == 'folder' %}
          <a href="/browse?path={{ it.rel_path|urlencode }}">{{ it.name }}</a>
        {% else %}
          <a href="/unit/{{ it.id }}">{{ it.name }}</a>
        {% endif %}
        {% if it.is_course %}<span class="badge-course">course</span>{% endif %}
        {% if it.is_unit %}<span class="badge-unit">unit</span>{% endif %}
        {% if it.is_deleted %}<span class="badge-missing">missing</span>{% endif %}
      </td>
      <td class="small">{{ it.item_type }}</td>
      <td class="small">{{ it.size or 0 }}</td>
      <td class="small">{{ it.mtime|round|int if it.mtime else '-' }}</td>
      <td><button class="btn btn-sm btn-outline-secondary" onclick="openExplorer({{ it.rel_path|tojson }})">Open</button></td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<div class="alert alert-info">Empty folder or not indexed yet. Click Re-Scan.</div>
{% endif %}
{% endblock %}